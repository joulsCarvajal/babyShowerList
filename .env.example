# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env (ya está en .gitignore).

# Local (dev con `npm run dev`): la ruta es relativa al dir de schema.prisma (./prisma/).
# Docker (compose o Railway): file:/data/babyshower.db
DATABASE_URL=file:./dev.db

# Contraseña del admin (/admin/login). Cámbiala.
ADMIN_PASSWORD=cambiame

# Secreto para firmar la cookie de sesión admin. Generar con:
#   openssl rand -hex 32
# Mínimo 32 caracteres.
SESSION_SECRET=cambiame_minimo_32_caracteres_aleatorios_largos

NODE_ENV=development
